{
  "name": "arduino-forge",
  "version": "1.0.0",
  "description": "AI-powered Arduino/ESP32 code generator — describe what you want, get working embedded C++ with wiring diagrams",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --env-file=.env server.js",
    "test": "node --test tests/**/*.test.js",
    "lint": "eslint src/ public/js/ --ext .js",
    "lint:fix": "eslint src/ public/js/ --ext .js --fix",
    "db:reset": "node -e \"import('./config/database.js')\"",
    "docker:build": "docker build -t arduino-forge .",
    "docker:run": "docker run -p 3000:3000 --env-file .env arduino-forge"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.8.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fuse.js": "^7.0.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "rate-limiter-flexible": "^4.0.1"
  },
  "devDependencies": {
    "eslint": "^8.54.0"
  },
  "keywords": [
    "arduino",
    "esp32",
    "embedded",
    "code-generator",
    "ai",
    "microcontroller",
    "iot",
    "education"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SKar-2007/arduino-forge"
  }
}
